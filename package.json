{
  "name": "mordus-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @mordus-platform/db db:push",
    "db:studio": "pnpm --filter @mordus-platform/db db:studio",
    "db:generate": "pnpm --filter @mordus-platform/db db:generate",
    "db:migrate": "pnpm --filter @mordus-platform/db db:migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "oxlint && oxfmt --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mordus-platform/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kubojs/config": "0.7.2",
    "@mordus-platform/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.23.0"
}
